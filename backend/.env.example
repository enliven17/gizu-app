NODE_ENV=local
PORT=3000
DATABASE_URL=postgres://private_investment:private_investment@localhost:54329/private_investment
MERKL_API_URL=https://api.merkl.xyz
MERKL_API_KEY=merkl-api-key
# Chain order is the mobile filter order; the first chain is selected initially.
CATALOG_CHAINS_JSON='[{"id":4663,"name":"Robinhood"},{"id":1,"name":"Ethereum"},{"id":143,"name":"Monad"}]'
# Optional Morpho contracts on ANY enabled chain, merged with chain-filtered Merkl results.
# Add Ethereum (1), Robinhood (4663), or other enabled chain entries in the same array.
CATALOG_VAULTS_JSON='[{"chainId":143,"address":"0x997D5064A7B48305c15C9D55AC2D94D7069Fc008","name":"Gizu Prime AUSD","symbol":"gzpAUSD","description":"Gizu Prime AUSD vault on Morpho, Monad mainnet.","depositUrl":"https://app.morpho.org/monad/vault/0x997D5064A7B48305c15C9D55AC2D94D7069Fc008/gizu-prime-ausd#overview","asset":{"address":"0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a","name":"AUSD","symbol":"AUSD","decimals":6}}]'
MORPHO_API_URL=https://api.morpho.org/graphql
ONEINCH_API_KEY=your-1inch-api-key
# Server-held credentials for Swap and Earn; never expose via EXPO_PUBLIC_*.
AURORA_API_KEY=your-aurora-api-key
PIMLICO_API_KEY=your-pimlico-api-key

# Required for confidential balances, authenticated history and qualified one-leg quotes.
# Configure the provider credential on the server, never in EXPO_PUBLIC_* variables.
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# EARN_ANVIL_PATH=.runtime/anvil-v1.8.3/anvil-fork
# Render uses npm ci --include=dev && npm run build:render; see DEPLOYMENT.md.
# EARN_AURORA_FEE_QUALIFICATION_JSON must name an operator-verified actual provider collector.
# See DEPLOYMENT.md for the versioned route-specific, zero-Gizu/integrator fee qualification.

# Required for executable private payout recovery across server restarts.
# Durable server-only AES-256 key: exactly 64 hex characters; retain across restarts.
# EARN_GATEWAY_RECOVERY_KEY=your-64-hex-character-recovery-key

# Enable only after this key's operation-specific authenticated history access is verified.
# EARN_AURORA_HISTORY_QUALIFIED=false
