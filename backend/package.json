{
  "name": "private-investment-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node --experimental-transform-types --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-transform-types --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/type-provider-zod": "1.0.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "viem": "2.56.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
