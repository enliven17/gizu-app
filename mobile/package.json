{
  "name": "gizu-mobile",
  "version": "0.4.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "start": "node scripts/start-app.cjs app",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:functional": "jest --runInBand tests/functional",
    "test:coverage": "jest --runInBand --coverage",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run doctor && npm run test:coverage",
    "export": "expo export --platform ios --platform android",
    "hooks:install": "node scripts/install-hooks.cjs",
    "precommit": "node scripts/precommit.cjs",
    "signer:build": "bash modules/gizu-signer/scripts/build.sh",
    "signer:test": "cargo test --locked --manifest-path modules/gizu-signer/core/Cargo.toml",
    "debug:ui": "node scripts/start-app.cjs ui",
    "stored-signer:build": "bash modules/gizu-stored-signer/scripts/build.sh",
    "stored-signer:test": "cargo test --locked --manifest-path modules/gizu-stored-signer/core/Cargo.toml",
    "debug:testnet": "node scripts/start-app.cjs testnet",
    "debug:stored-wallet": "node scripts/start-app.cjs stored-wallet",
    "format:kotlin": "node scripts/format-kotlin.cjs write",
    "format:kotlin:check": "node scripts/format-kotlin.cjs check",
    "stored-signer:build:ios": "bash modules/gizu-stored-signer/scripts/build.sh ios",
    "stored-signer:test:ios": "bash modules/gizu-stored-signer/scripts/test-ios.sh",
    "stored-signer:check:ios": "node scripts/check-ios-signer.cjs",
    "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/elements": "2.9.43",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.26",
    "expo-application": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-localization": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "1.47.0",
    "nativewind": "4.2.7",
    "posthog-react-native": "^4.78.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "gizu-signer"
      ]
    }
  }
}
