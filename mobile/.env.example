# Public configuration only; never add key material or secrets here.
# Native is the only supported mode and the default when omitted.
EXPO_PUBLIC_PASSKEY_MODE=native

# Read-only mainnet catalog API. USB Android: adb reverse tcp:3000 tcp:3000.
# Set a reachable HTTPS backend URL in release builds. Never place API secrets here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# TestFlight uses the EAS preview environment. Do not reuse the local URL above.
# Unset EXPO_PUBLIC_API_URL means catalog unavailable until hosting is configured.
