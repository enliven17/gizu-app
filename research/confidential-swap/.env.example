# Copy to .env (gitignored). Do not commit or paste keys into chat.
# First funded test: fill the REQUIRED block, leave the rest empty, TARGET=USDG.

# --- REQUIRED to run check / quote / fund ---
# https://studio.aurora.dev
AURORA_API_KEY=
# https://dashboard.pimlico.io
PIMLICO_API_KEY=
# Monad EOA that holds USDC and 0 MON. SOURCE_ADD must match SOURCE_PK.
SOURCE_PK=
SOURCE_ADD=
# Three fresh Robinhood wallets, all different from SOURCE. Addresses required for payouts.
# Private keys required only for swap-preview/send (stock route).
DEST1_PK=
DEST1_ADD=
DEST2_PK=
DEST2_ADD=
DEST3_PK=
DEST3_ADD=
# Your own Monad wallet, to pull leftover SOURCE USDC back. Not SOURCE, not A1-A3.
RECOVER_ADD=

# --- REQUIRED for assets and stock quotes ---
# https://business.1inch.com/portal
ONEINCH_API_KEY=

# --- First-run defaults (safe to keep) ---
DESTINATION=robinhood
TARGET=USDG
# Only if buying WETH/USDe through USDG instead of a direct Aurora payout
ROUTE=
SWAP_SLIPPAGE_BPS=100
LIQUIDITY_REFERENCE_USDG=1000
MAX_PRICE_IMPACT_BPS=100
ONEINCH_DELAY_MS=1100
MONAD_RPC_URL=https://rpc.monad.xyz
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEAR_RPC_URL=https://rpc.mainnet.near.org
ROBINHOOD_USDG_CONTRACT=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
SWAP_ROUTER=0x111111125421cA6dc452d289314280a0f8842A65
MONAD_USDC_CONTRACT=0x754704bc059f8c67012fed69bc8a327a5aafb603
# Gasless USDG -> stock via 1inch Fusion (fusion-preview/send/status); uses ONEINCH_API_KEY
FUSION_TARGET=AMZN
FUSION_PRESET=fast
FUSION_SLIPPAGE_BPS=100
FUSION_API_URL=https://api.1inch.com/fusion

# --- Fill after `npm run tokens` if Aurora lists more than one match ---
MONAD_ASSET_ID=
PRIVATE_ASSET_ID=
ROBINHOOD_ASSET_ID=
# Ethereum vault leftovers; unused when DESTINATION=robinhood
ETHEREUM_ASSET_ID=
ETHEREUM_USDC_CONTRACT=
ETHEREUM_RPC_URL=
CONFIDENTIAL_TOKEN_ID=
